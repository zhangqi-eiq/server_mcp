# Normalize line endings on checkout — keep LF in repo, allow CRLF on Windows checkouts
* text=auto eol=lf

# Python sources are always LF
*.py           text eol=lf
*.pyi          text eol=lf

# Shell scripts and config
*.sh           text eol=lf
*.json         text eol=lf
*.toml         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf

# Windows scripts may need CRLF on Windows
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# Documentation
*.md           text eol=lf
LICENSE        text eol=lf

# Keep these binary even if they look text
*.png          binary
*.jpg          binary
*.gif          binary
*.ico          binary
*.pdf          binary
*.zip          binary
*.gz           binary
*.whl          binary
*.exe          binary
