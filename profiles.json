{
  "active_profile": "default",
  "profiles": {
    "default": {
      "ssh": {
        "host": "your-server.example.com",
        "port": 22,
        "username": "your-username",
        "auth": {
          "type": "key",
          "key_path": "~/.ssh/id_ed25519",
          "password": "",
          "key_password": ""
        },
        "connect_timeout": 10,
        "keepalive_interval": 30
      },
      "allowed_paths": [
        "/home/your-username/projects"
      ],
      "security": {
        "blocked_commands": [
          "rm -rf /",
          "rm -rf /*",
          "mkfs",
          "dd if=",
          "format",
          "shutdown",
          "reboot",
          "halt",
          "poweroff",
          "init 0",
          "init 6",
          ":(){:|:&};:",
          "chmod -R 777 /",
          "chown -R",
          "> /dev/sd",
          "echo > /dev/sd"
        ],
        "max_file_size_mb": 50,
        "max_output_chars": 100000,
        "command_timeout": 30
      }
    }
  }
}
